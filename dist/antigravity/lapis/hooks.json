{
  "lapis-stop": {
    "Stop": [
      {
        "type": "command",
        "timeout": 60,
        "command": "lapis-design-hook --plugin-version 0.2.0 --host antigravity stop || exit 0"
      }
    ]
  },
  "lapis-pre-write": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "lapis-design-hook --plugin-version 0.2.0 --host antigravity pre-write || exit 0"
          }
        ]
      }
    ]
  }
}
