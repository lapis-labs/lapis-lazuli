  "license": "MIT AND CC-BY-4.0",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "lapis-design-hook --plugin-version 0.2.0 exit-plan",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
