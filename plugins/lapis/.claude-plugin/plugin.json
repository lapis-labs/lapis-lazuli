{
  "name": "lapis",
  "version": "0.2.0",
  "description": "Design direction, plans, and named defaults for new UI and redesigns",
  "author": {
    "name": "lapis-labs"
  },
  "homepage": "https://github.com/lapis-labs/lapis-lazuli",
