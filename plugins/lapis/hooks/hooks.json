{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lapis-design-hook --plugin-version 0.2.0 stop",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "lapis-design-hook --plugin-version 0.2.0 pre-write",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
